---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon is:inline name="material-symbols:group" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {
          description && (
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              {description}
            </p>
          )
        }
      </div>

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon is:inline
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid my-4">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
              <Icon is:inline name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
          items.map((item) => (
            <a
              href={item.siteurl}
              target="_blank"
              rel="noopener noreferrer"
              data-tags={item.tags?.join(",")}
              class:list={["friend-card", item.cover && "friend-card--with-image"]}
            >
              {/* 封面横幅（可选） */}
              {item.cover && (
                <span class="friend-card__cover is-loading" data-friend-cover>
                  <span class="friend-card__cover-loader" aria-hidden="true"></span>
                  <img
                    class="friend-card__cover-img"
                    src={item.cover}
                    alt={item.title}
                    loading="lazy"
                    decoding="async"
                    onload="this.closest('.friend-card__cover')?.classList.remove('is-loading')"
                    onerror="this.closest('.friend-card__cover')?.classList.remove('is-loading'); this.closest('.friend-card__cover')?.classList.add('is-error')"
                  />
                  <svg
                    class="friend-card__wave"
                    viewBox="0 0 400 24"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M0,12 Q50,2 100,12 T200,12 T300,12 T400,12 V24 H0 Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                </span>
              )}

              <span class="friend-card__body">
                <span class="friend-card__info">
                  {/* 圆形头像 */}
                  <span class="friend-card__avatar" data-friend-avatar>
                    <img
                      src={item.imgurl}
                      alt={item.title}
                      loading="lazy"
                      decoding="async"
                      onerror="this.closest('.friend-card__avatar')?.classList.add('is-error')"
                    />
                    <span class="friend-card__avatar-fallback" aria-hidden="true">
                      {item.title.charAt(0)}
                    </span>
                  </span>

                  <span class="friend-card__meta">
                    <span class="friend-card__name-row">
                      <strong class="friend-card__name" title={item.title}>
                        {item.title}
                      </strong>
                      <Icon is:inline
                        name="material-symbols:arrow-outward-rounded"
                        class="friend-card__jump-icon"
                      />
                    </span>
                    <span class="friend-card__url" title={item.siteurl}>
                      {item.siteurl.replace(/^https?:\/\//, "").split(/[/?#]/)[0]}
                    </span>
                  </span>
                </span>

                <span class="friend-card__divider" aria-hidden="true"></span>

                <span class="friend-card__desc">{item.desc}</span>

                {/* 标签 */}
                {item.tags && item.tags.length > 0 && (
                  <span class="friend-card__tags">
                    {item.tags.slice(0, 3).map((tag) => (
                      <span class="friend-card__tag">{tag}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          ))
        }
      </div>

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon is:inline name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");

          filters.forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (cardEl.querySelector(".friend-card__name")?.textContent || "").toLowerCase();
            const desc = (cardEl.querySelector(".friend-card__desc")?.textContent || "").toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }
  </script>

  <style is:global>
    .friends-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      padding: 0.25rem 0 1.5rem;
      display: grid;
    }

    .friend-card {
      border-radius: var(--radius-large, 0.75rem);
      border: 2px solid var(--deep-text);
      background: transparent;
      color: var(--deep-text);
      flex-direction: column;
      text-decoration: none;
      transition: border-color 0.3s, box-shadow 0.3s, background-color 0.3s;
      display: flex;
      position: relative;
      overflow: hidden;
    }
    .friend-card:hover {
      background: color-mix(in srgb, var(--content-meta) 6%, transparent);
    }
    .friend-card:has(.friend-card__cover):hover {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    :root.dark .friend-card:has(.friend-card__cover):hover {
      box-shadow: 0 4px 20px rgba(255, 255, 255, 0.08);
    }

    .friend-card__cover {
      height: 0;
      opacity: 0;
      display: block;
      position: relative;
      overflow: hidden;
      transition: height 0.3s ease, opacity 0.35s ease;
    }
    .friend-card:hover .friend-card__cover {
      height: 7rem;
      opacity: 1;
    }
    .friend-card__cover-img {
      object-fit: cover;
      width: 100%;
      height: 100%;
      transition: opacity 0.4s;
      display: block;
    }
    .friend-card__cover-loader {
      --ballcolor: oklch(60% 0 0);
      --shadow: 0 0 #fff0;
      --shadowcolor: #fff0;
      pointer-events: none;
      border-radius: 50%;
      width: 10px;
      height: 10px;
      display: none;
      position: absolute;
      top: calc(50% - 5px);
      left: calc(50% - 155px);
    }
    :root.dark .friend-card__cover-loader {
      --ballcolor: oklch(75% 0 0);
    }
    .friend-card__cover.is-loading .friend-card__cover-loader {
      animation: 2s linear infinite friendShadowRolling;
      display: block;
    }
    .friend-card__cover.is-loading .friend-card__cover-img {
      opacity: 0;
    }
    .friend-card__cover.is-error {
      display: none;
    }

    .friend-card__wave {
      width: 100%;
      height: 1.25rem;
      color: transparent;
      pointer-events: none;
      display: block;
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
    }

    .friend-card__body {
      flex-direction: column;
      flex: 1;
      padding: 0.875rem 1rem;
      display: flex;
    }
    .friend-card__info {
      align-items: center;
      gap: 0.75rem;
      display: flex;
    }
    .friend-card__avatar {
      border: 2px solid var(--deep-text);
      background: transparent;
      border-radius: 999px;
      flex-shrink: 0;
      width: 2.75rem;
      height: 2.75rem;
      position: relative;
      overflow: hidden;
    }
    .friend-card__avatar img {
      object-fit: cover;
      width: 100%;
      height: 100%;
      display: block;
    }
    .friend-card__avatar-fallback {
      color: var(--deep-text);
      justify-content: center;
      align-items: center;
      font-size: 1.125rem;
      font-weight: 700;
      display: none;
      position: absolute;
      inset: 0;
    }
    .friend-card__avatar.is-error img {
      display: none;
    }
    .friend-card__avatar.is-error .friend-card__avatar-fallback {
      display: flex;
    }

    .friend-card__meta {
      flex-direction: column;
      flex: 1;
      gap: 0.2rem;
      min-width: 0;
      display: flex;
    }
    .friend-card__name-row {
      align-items: center;
      gap: 0.375rem;
      min-width: 0;
      display: flex;
    }
    .friend-card__name {
      color: var(--deep-text);
      white-space: nowrap;
      text-overflow: ellipsis;
      min-width: 0;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.3;
      overflow: hidden;
    }
    .friend-card__jump-icon {
      color: var(--primary);
      opacity: 0;
      flex-shrink: 0;
      width: 0.875rem;
      height: 0.875rem;
      transition: opacity 0.2s, transform 0.2s;
      transform: translate(-3px, 3px);
    }
    .friend-card:hover .friend-card__jump-icon,
    .friend-card:focus-visible .friend-card__jump-icon {
      opacity: 1;
      transform: translate(0);
    }

    .friend-card__url {
      color: var(--content-meta);
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: 0.75rem;
      font-weight: 500;
      transition: color 0.2s;
      overflow: hidden;
    }
    .friend-card:hover .friend-card__url {
      color: var(--deep-text);
    }

    .friend-card__desc {
      color: var(--content-meta);
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      font-size: 0.8rem;
      line-height: 1.5;
      display: -webkit-box;
      overflow: hidden;
    }

    .friend-card__divider {
      background: var(--line-divider);
      height: 1px;
      margin: 0.75rem 0 0.625rem;
    }

    .friend-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin-top: 0.5rem;
    }
    .friend-card__tag {
      font-size: 0.65rem;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      background: color-mix(in srgb, var(--content-meta) 10%, transparent);
      color: var(--content-meta);
    }

    @keyframes friendShadowRolling {
      0% {
        box-shadow: var(--shadow), var(--shadow), var(--shadow), var(--shadow);
      }
      12% {
        box-shadow: 100px 0 var(--ballcolor), var(--shadow), var(--shadow), var(--shadow);
      }
      25% {
        box-shadow: 110px 0 var(--ballcolor), 100px 0 var(--ballcolor), var(--shadow), var(--shadow);
      }
      36% {
        box-shadow: 120px 0 var(--ballcolor), 110px 0 var(--ballcolor), 100px 0 var(--ballcolor), var(--shadow);
      }
      50% {
        box-shadow: 130px 0 var(--ballcolor), 120px 0 var(--ballcolor), 110px 0 var(--ballcolor), 100px 0 var(--ballcolor);
      }
      62% {
        box-shadow: 200px 0 var(--shadowcolor), 130px 0 var(--ballcolor), 120px 0 var(--ballcolor), 110px 0 var(--ballcolor);
      }
      75% {
        box-shadow: 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor), 130px 0 var(--ballcolor), 120px 0 var(--ballcolor);
      }
      87% {
        box-shadow: 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor), 130px 0 var(--ballcolor);
      }
      to {
        box-shadow: 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor), 200px 0 var(--shadowcolor);
      }
    }

    @media (max-width: 1024px) {
      .friends-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .friends-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</MainGridLayout>
