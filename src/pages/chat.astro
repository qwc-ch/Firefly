---
import Navbar from "@components/layout/Navbar.astro";
import AiChatPage from "@components/pages/AiChatPage.svelte";
import Layout from "@layouts/Layout.astro";

const title = "AI 聊天";
const description = "与流萤AI聊天";
---

<Layout title={title} description={description}>
    <div
      id="top-row"
      class="z-50 pointer-events-none relative transition-all duration-700 mx-auto w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4"
    >
      <div id="navbar-wrapper" class="pointer-events-auto transition-all sticky top-0">
        <Navbar />
      </div>
    </div>
    <div class="min-h-[80vh] mt-20 px-2 md:px-4">
        <AiChatPage client:load />
    </div>
</Layout>