---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

// imageUpload 是本主题自己的配置项，不属于 Waline 初始化参数，先取出
const { imageUpload, ...walineOptions } = commentConfig.waline ?? {};

const config = {
	...walineOptions,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  {commentConfig.waline?.cssUrl && (
    <link rel="stylesheet" href={commentConfig.waline.cssUrl} />
  )}
  <script type="module" is:inline define:vars={{ config, imageUpload }}>
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';

    // ===== 评论图片：选图时只插入占位符，点"发送"时才统一上传，再放行提交 =====
    // 上传服务（EdgeOne 边缘函数）负责持有图床鉴权码，前端不保存任何密钥。
    const PENDING_PREFIX = "pending://";
    const pendingImages = new Map(); // 占位 token -> File
    let uploading = false;

    // 上传一张图，返回图床展示链接
    const uploadOne = async (file) => {
      const form = new FormData();
      form.append("file", file, file.name);

      let res;
      try {
        res = await fetch(imageUpload.endpoint, { method: "POST", body: form });
      } catch {
        throw new Error("图片上传失败：无法连接上传服务，请稍后重试");
      }

      let data = null;
      try {
        data = await res.json();
      } catch {
        /* 非 JSON 响应交给下方状态码分支处理 */
      }

      if (!res.ok) {
        const reason = data && (data.error || data.message);
        throw new Error(`图片上传失败（HTTP ${res.status}）${reason ? `：${reason}` : ""}`);
      }

      const item = Array.isArray(data) ? data[0] : data;
      const url = item && (item.url || item.src || item.publicUrl);
      if (!url) throw new Error("图片上传失败：上传服务返回内容异常");
      return url;
    };

    // 把编辑器文本里的占位 token 替换为真实链接（需经原生 setter + input 事件同步进 Waline 状态）
    const replaceToken = (token, url) => {
      const textarea = document.querySelector("#waline .wl-editor");
      if (!textarea || !textarea.value.includes(token)) return;
      const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, "value").set;
      setter.call(textarea, textarea.value.replaceAll(token, url));
      textarea.dispatchEvent(new Event("input", { bubbles: true }));
    };

    if (imageUpload?.enable && imageUpload?.endpoint) {
      // 选图/粘贴/拖拽：不真正上传，立即返回占位 token 交给 Waline 写进文本
      config.imageUploader = (file) => {
        const id = globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
        const token = `${PENDING_PREFIX}${id}/${encodeURIComponent(file.name)}`;
        pendingImages.set(token, file);
        return Promise.resolve(token);
      };

      // 把待传图片全部传完并把占位替换为真实链接，最后放行一次原生提交；
      // 某张失败时快速中止（已成功的保持不变，剩余的下次点发送时补传）
      const flushAndSubmit = async (submitBtn) => {
        uploading = true;
        if (submitBtn) submitBtn.disabled = true;
        try {
          for (const [token, file] of [...pendingImages]) {
            // 占位已被用户从文本中删掉的图片直接丢弃，不上传
            const textarea = document.querySelector("#waline .wl-editor");
            if (!textarea || !textarea.value.includes(token)) {
              pendingImages.delete(token);
              continue;
            }
            try {
              const url = await uploadOne(file);
              pendingImages.delete(token);
              replaceToken(token, url);
            } catch (err) {
              alert((err instanceof Error ? err.message : "图片上传失败"));
              return;
            }
          }
          if (pendingImages.size === 0) {
            if (submitBtn) submitBtn.disabled = false;
            submitBtn?.click();
          }
        } finally {
          uploading = false;
          if (submitBtn) submitBtn.disabled = false;
        }
      };

      // Waline 的提交入口只有两个：发送按钮 click 和编辑器 Ctrl/Cmd+Enter（都调 submitComment）。
      // 在容器捕获阶段拦截这两个路径：有待传图片时先上传，否则完全不接管。
      const walineRoot = document.getElementById("waline");
      walineRoot.addEventListener(
        "click",
        (event) => {
          const btn = event.target.closest(".wl-btn.primary");
          if (!btn || uploading || pendingImages.size === 0) return;
          event.preventDefault();
          event.stopPropagation();
          flushAndSubmit(btn);
        },
        true,
      );
      walineRoot.addEventListener(
        "keydown",
        (event) => {
          if (!((event.ctrlKey || event.metaKey) && event.key === "Enter")) return;
          if (uploading || pendingImages.size === 0) return;
          event.preventDefault();
          event.stopPropagation();
          flushAndSubmit(document.querySelector("#waline .wl-btn.primary"));
        },
        true,
      );
    }

    const requestedPath = new URLSearchParams(window.location.search).get("path");
    const effectiveConfig = requestedPath
      ? { ...config, path: requestedPath }
      : config;
    try {
      init(effectiveConfig);
    } catch (error) {
      console.error("[Waline] Failed to initialize:", error);
    }
  </script>
</div>

<style is:global>
  /* 各分类表情数量不同，切换时面板布局会跟着变，下面逐项消除 */

  .wl-tab-wrapper {
    /* 内容溢出时出现的滚动条会挤掉约 6px 宽度，网格随之重排 */
    scrollbar-gutter: stable;
    /* 内容不足时网格区按内容收缩，比顶满时矮 1px；固定高度使其恒定。
       145px 取自 Waline 自身的 max-height，其大版本若调整需同步 */
    height: 145px;
  }

  /* Waline 给选中态加了 0 1px 1px 边框，激活的 tab 比未激活宽 2px、高 1px，
     切换时相邻 tab 会左右挪；给未选中的补等宽透明边框统一占位 */
  .wl-tabs .wl-tab:not(.active) {
    border: solid transparent;
    border-width: 0 1px 1px;
  }
</style>
