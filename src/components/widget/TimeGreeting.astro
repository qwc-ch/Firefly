---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { getFallbackFormat, getImageQuality } from "@/utils/image-utils";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;

// 问候卡壁纸：src/assets/greeting-wallpapers/ 下的图片经 Astro 图片管线压缩后
// 随机选用。其中 greeting-api.* 由 scripts/fetch-greeting-wallpaper.ts 在每次
// 构建时从随机图 API（random-api.czl.net，单张 3MB+，大陆访问慢且不支持 URL
// 压缩参数）现场抽取下载，构建产物不入库；目录里也可以手动放自己的图。
// 目录为空时回退到运行时随机图 API。
// 用懒加载 glob（import: "default"，不带 eager），await 后得到带 width/height
// 的 ImageMetadata，传给 getImage 才不会当作远程图而报缺尺寸。
const greetingImageLoaders = import.meta.glob<ImageMetadata>(
	"/src/assets/greeting-wallpapers/*.{webp,avif,jpg,jpeg,png}",
	{ import: "default" },
);

// 卡片实际显示约 400×144，2x 屏 1280px 足够；小图不放大
const GREETING_MAX_WIDTH = 1280;
const format = getFallbackFormat();
const quality = getImageQuality();
const greetingWallpapers = await Promise.all(
	Object.values(greetingImageLoaders).map(async (loader) => {
		const img = await loader();
		const width =
			img.width > GREETING_MAX_WIDTH ? GREETING_MAX_WIDTH : undefined;
		const optimized = await getImage({
			src: img,
			...(width ? { width } : {}),
			format,
			quality,
		});
		return optimized.src;
	}),
);
---

<div
	id="time-greeting"
	class:list={["card-base flex flex-col relative overflow-hidden", className]}
	style={style}
>
	<div class="px-5 pt-5 pb-3 flex justify-between items-start">
		<div class="flex flex-col gap-1">
			<span class="text-base font-bold text-neutral-700 dark:text-neutral-300 greeting-text"
				>正在获取时间...</span
			>
			<div class="flex items-end gap-3 text-neutral-800 dark:text-neutral-200">
				<div class="flex items-baseline">
					<span class="text-4xl font-bold font-mono time-display">--:--</span>
				</div>
				<div class="flex flex-col mb-[0.15rem]">
					<span class="text-xs font-bold opacity-60 uppercase tracking-wider date-week"
						>---</span
					>
					<div class="flex items-baseline text-sm font-bold opacity-80">
						<span class="date-day">--</span>
						<span class="opacity-80 ml-0.5 date-month">/--</span>
					</div>
				</div>
			</div>
		</div>
		<div class="text-2xl text-(--primary) greeting-icons mt-1 opacity-80">
			<Icon name="material-symbols:mode-night-outline-rounded" class="hidden icon-night" />
			<Icon name="material-symbols:wb-twilight-rounded" class="hidden icon-morning" />
			<Icon name="material-symbols:wb-sunny-outline-rounded" class="hidden icon-noon" />
			<Icon name="material-symbols:nightlight-outline-rounded" class="hidden icon-evening" />
		</div>
	</div>
	<div class="w-full h-36 relative overflow-hidden time-image-container">
		<div
			class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 time-image"
		>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-t from-(--card-bg) via-transparent to-transparent opacity-60"
		>
		</div>
	</div>
</div>

<script is:inline define:vars={{ greetingWallpapers }}>
	(() => {
		const weekDays = [
			"Sunday",
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
		];
		if (!window.timeGreetingImage) {
			if (greetingWallpapers && greetingWallpapers.length) {
				// 本地壁纸池：每次整页加载随机一张（同源小图，浏览器可缓存，Swup 换页复用同一张）
				window.timeGreetingImage =
					greetingWallpapers[Math.floor(Math.random() * greetingWallpapers.length)];
			} else {
				window.timeGreetingImage = `https://random-api.czl.net/pic/fj?t=${new Date().getTime()}`;
			}
		}
		function updateTimeGreeting() {
			const now = new Date();
			const hours = now.getHours();
			const minutes = now.getMinutes();
			const month = (now.getMonth() + 1).toString().padStart(2, "0");
			const day = now.getDate().toString().padStart(2, "0");
			const hoursStr = hours.toString().padStart(2, "0");
			const minutesStr = minutes.toString().padStart(2, "0");
			let greeting = "",
				period = "";
			if (hours >= 0 && hours < 6) {
				greeting = "夜深了，早点休息！";
				period = "night";
			} else if (hours >= 6 && hours < 9) {
				greeting = "早上好，新的一天！";
				period = "morning";
			} else if (hours >= 9 && hours < 12) {
				greeting = "上午好，充满活力！";
				period = "noon";
			} else if (hours >= 12 && hours < 14) {
				greeting = "中午好，记得午休！";
				period = "noon";
			} else if (hours >= 14 && hours < 18) {
				greeting = "下午好，继续加油！";
				period = "noon";
			} else if (hours >= 18 && hours < 24) {
				greeting = "晚上好，放松一下！";
				period = "evening";
			}
			document
				.querySelectorAll(".date-day")
				.forEach((e) => (e.textContent = day));
			document
				.querySelectorAll(".date-month")
				.forEach((e) => (e.textContent = `/${month}`));
			document
				.querySelectorAll(".date-week")
				.forEach((e) => (e.textContent = weekDays[now.getDay()]));
			document
				.querySelectorAll(".time-display")
				.forEach((e) => (e.textContent = `${hoursStr}:${minutesStr}`));
			document
				.querySelectorAll(".greeting-text")
				.forEach((e) => (e.textContent = greeting));
			document.querySelectorAll(".greeting-icons").forEach((c) => {
				c.querySelectorAll("svg").forEach((i) => {
					i.classList.toggle("hidden", !i.classList.contains(`icon-${period}`));
				});
			});
			document.querySelectorAll(".time-image").forEach((e) => {
				if (e.getAttribute("data-image-set") !== "true") {
					const img = new Image();
					img.onload = () => {
						e.style.backgroundImage = `url('${window.timeGreetingImage}')`;
						setTimeout(() => e.classList.replace("opacity-0", "opacity-100"), 50);
					};
					img.onerror = () => {
						e.closest(".time-image-container")?.classList.add("hidden");
					};
					img.src = window.timeGreetingImage;
					e.setAttribute("data-image-set", "true");
				}
			});
		}
		if (window.timeGreetingTimer) clearTimeout(window.timeGreetingTimer);
		// 对齐到下一分钟边界再按分钟刷新，避免时钟最多滞后 59 秒
		const msUntilNextMinute = 60000 - (Date.now() % 60000);
		window.timeGreetingTimer = setTimeout(() => {
			updateTimeGreeting();
			window.timeGreetingTimer = setInterval(updateTimeGreeting, 60000);
		}, msUntilNextMinute);
		updateTimeGreeting();
		if (!window.timeGreetingSwupBound) {
			window.timeGreetingSwupBound = true;
			document.addEventListener("swup:contentReplaced", () => updateTimeGreeting());
		}
	})();
</script>
